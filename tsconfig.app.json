{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    // `node` is here for the build-output test (e2e/pwa-build.test.ts), which
    // reads dist/sw.js. Application code never imports node builtins and the
    // ESLint boundary rules keep it that way.
    "types": ["vite/client", "vite-plugin-pwa/client", "node"]
  },
  "include": ["src", "e2e"]
}
